[_bglUnsignedCompare x y u v;
    if (x == y) {
        return 0;
    }
    if (x < 0 && y >= 0) {
        return 1;
    }
    if (x >= 0 && y < 0) {
        return -1;
    }
    u=x & 32767;
    v=y & 32767;
    if (u > v) {
        return 1;
    }
    return -1;
];

