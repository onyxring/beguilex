[add a b s;
    s=a + b;
    return s;
];
[fib n;
    if (n < 2) {
        return n;
    }
    return fib(n - 1) + fib(n - 2);
];
[initialise x y f;
    x = 5;
    y=add(x,3);
    f=fib(6);
    print y;
    print f;
];
