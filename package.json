{
  "name": "beguile-language",
  "displayName": "Beguilex",
  "description": "Syntax highlighting for the Beguile Interactive Fiction language",
  "version": "0.2.0",
  "publisher": "OnyxRing",
  "engines": { "vscode": "^1.75.0" },
  "icon": "images/icon.png",
  "categories": ["Programming Languages"],
  "repository": {
    "type": "git",
    "url": "https://github.com/onyxring/beguilex"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "beguile",
        "aliases": ["Beguile", "bgl"],
        "extensions": [".bgl"],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "inform6",
        "aliases": ["Inform 6"],
        "extensions": [".inf"]
      }
    ],
    "grammars": [
      {
        "language": "beguile",
        "scopeName": "source.beguile",
        "path": "./syntaxes/beguile.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.i6.beguile": "inform6",
          "meta.embedded.emitter.i6.beguile": "inform6"
        }
      }
    ],
    "configuration": [
      {
        "title": "Edit & Debug",
        "id": "Beguilex",
        "properties": {
          "Beguilex.interpreterTheme": {
            "type": "string",
            "enum": ["auto", "dark", "light"],
            "enumDescriptions": [
              "Follow the active VS Code color theme",
              "Dark background",
              "Light / parchment background"
            ],
            "default": "auto",
            "description": "Color theme for the interpreter panels."
          }
        }
      },
      {
        "title": "Beguiler",
        "id": "Beguiler",
        "properties": {
          "beguiler.path": {
            "order": 1,
            "type": "string",
            "default": "",
            "markdownDescription": "Path to the beguiler compiler binary. *(Should be an absolute path.)*"
          },
          "beguiler.libraryPath": {
            "order": 2,
            "type": "string",
            "default": "beguiLib",
            "markdownDescription": "Path to the Beguile system library. *(Can be absolute, or relative to the beguiler binary.)*"
          },
          "beguiler.outputPath": {
            "order": 3,
            "type": "string",
            "default": "output",
            "markdownDescription": "Output directory for compiled game files. *(Should be relative to the source file.)*"
          },
          "beguiler.errorFormat": {
            "order": 5,
            "type": "string",
            "enum": ["E0", "E1", "E2"],
            "enumDescriptions": [
              "Archimedes-style",
              "Microsoft-style",
              "Mac MPW-style"
            ],
            "default": "E1",
            "markdownDescription": "Error output format used by Beguiler. *(Also passed to I6.)*"
          },
          "beguiler.target": {
            "order": 4,
            "type": "string",
            "enum": ["", "Glulx", "Z3", "Z5", "Z8"],
            "enumDescriptions": [
              "Use the target specified in the .bgl source file",
              "Glulx (32-bit, .ulx)",
              "Z-machine version 3 (.z3)",
              "Z-machine version 5 (.z5)",
              "Z-machine version 8 (.z8)"
            ],
            "default": "",
            "markdownDescription": "Target platform. *(Usually set in source.)*"
          },
          "beguiler.extraArgs": {
            "order": 6,
            "type": "string",
            "default": "",
            "description": "Extra command-line arguments appended to every beguiler invocation."
          }
        }
      },
      {
        "title": "Inform 6",
        "id": "i6",
        "properties": {
          "i6.inform6Path": {
            "order": 1,
            "type": "string",
            "default": "",
            "markdownDescription": "Path to the Inform 6 compiler binary. *(Should be an absolute path.)*"
          },
          "i6.inform6SearchPath": {
            "order": 2,
            "type": "string",
            "default": "",
            "markdownDescription": "Inform 6 searches these paths to resolve #include directives, in addition to any specified in the beguile source *(Multiple paths may be comma-separated)*."
          },
          "i6.inform6ExtraArgs": {
            "order": 3,
            "type": "string",
            "default": "",
            "description": "Extra command-line arguments forwarded to the Inform 6 compiler."
          }
        }
      }
    ],
    "views": {
      "debug": [
        {
          "type": "webview",
          "id": "beguile.variableFilter",
          "name": "Variable Filter",
          "when": "debugType == beguile"
        }
      ]
    },
    "breakpoints": [
      { "language": "beguile" },
      { "language": "inform6" },
      { "language": "c" }
    ],
    "debuggers": [
      {
        "type": "beguile",
        "label": "Beguile",
        "languages": ["beguile"]
      }
    ],
    "commands": [
      {
        "command": "beguile.play",
        "title": "Beguile: Play"
      },
      {
        "command": "beguile.debug",
        "title": "Beguile: Debug"
      },
      {
        "command": "beguile.openI6Source",
        "title": "Open I6 Source at Current Line",
        "icon": {
          "light": "./media/i6-light.svg",
          "dark": "./media/i6-dark.svg"
        }
      },
      {
        "command": "beguile.openBglSource",
        "title": "Open BGL Source at Current Line",
        "icon": {
          "light": "./media/bgl-light.svg",
          "dark": "./media/bgl-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "beguile.openI6Source",
          "when": "beguile.showOpenI6Button && resourceExtname == .bgl",
          "group": "navigation"
        },
        {
          "command": "beguile.openBglSource",
          "when": "beguile.showOpenBglButton && resourceExtname == .inf",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "[beguile]": {
        "editor.semanticHighlighting.enabled": true
      },
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": [
              "storage.type.beguile",
              "storage.modifier.beguile",
              "storage.type.primitive.beguile"
            ],
            "settings": { "foreground": "#569CD6" }
          },
          {
            "scope": "keyword.control.beguile",
            "settings": { "foreground": "#C586C0" }
          },
          {
            "scope": [
              "keyword.control.directive.beguile",
              "keyword.control.directive.include.beguile",
              "keyword.control.directive.define.beguile",
              "keyword.control.directive.conditional.beguile"
            ],
            "settings": { "foreground": "#C586C0" }
          },
          {
            "scope": "constant.language.beguile",
            "settings": { "foreground": "#569CD6" }
          },
          {
            "scope": "string.quoted.double.beguile",
            "settings": { "foreground": "#CE9178" }
          },
          {
            "scope": "constant.numeric.beguile",
            "settings": { "foreground": "#B5CEA8" }
          },
          {
            "scope": "comment.line.beguile",
            "settings": { "foreground": "#6A9955" }
          },
          {
            "scope": [
              "constant.other.dictionary-word.beguile",
              "constant.other.dictionary-word.plural.beguile"
            ],
            "settings": { "foreground": "#C3A37A" }
          }
        ]
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "class:beguile":              "#4EC9B0",
          "class.declaration:beguile":  "#4EC9B0",
          "type:beguile":               "#4EC9B0",
          "enum:beguile":               "#4EC9B0",
          "enum.declaration:beguile":   "#4EC9B0",
          "enumMember:beguile":         "#4FC1FF",
          "variable:beguile":           "#9CDCFE",
          "property:beguile":           "#9CDCFE",
          "property.declaration:beguile": "#9CDCFE",
          "method:beguile":             "#DCDCAA",
          "method.declaration:beguile": "#DCDCAA",
          "function:beguile":           "#DCDCAA",
          "function.declaration:beguile": "#DCDCAA"
        }
      }
    },
    "semanticTokenScopes": [
      {
        "scopes": {
          "type":                 ["entity.name.type"],
          "class":                ["entity.name.type.class"],
          "class.declaration":    ["entity.name.type.class"],
          "enum":                 ["entity.name.type.enum"],
          "enum.declaration":     ["entity.name.type.enum"],
          "enumMember":           ["variable.other.enummember"],
          "variable":             ["variable.other.readwrite"],
          "property":             ["variable.other.property"],
          "property.declaration": ["variable.other.property"],
          "method":               ["entity.name.function.member"],
          "method.declaration":   ["entity.name.function.member"],
          "function":             ["entity.name.function"],
          "function.declaration": ["entity.name.function"]
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "vsce package",
    "deploy": "tsc -p ./ && code --command workbench.action.reloadWindow"
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "quixe": "^0.3.3",
    "ifvms": "^1.1.6"
  }
}
