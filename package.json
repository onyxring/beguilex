{
  "name": "beguile-language",
  "displayName": "Beguilex",
  "description": "Editor support, debugger, and embedded interpreter for the Beguile Interactive Fiction language",
  "version": "0.1.0-preview",
  "preview": true,
  "publisher": "OnyxRing",
  "engines": {
    "vscode": "^1.75.0"
  },
  "icon": "images/icon.png",
  "categories": [
    "Programming Languages"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/onyxring/beguilex"
  },
  "main": "./out/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "beguile",
        "aliases": [
          "Beguile",
          "bgl"
        ],
        "extensions": [
          ".bgl"
        ],
        "configuration": "./language-configuration.json"
      },
      {
        "id": "inform6",
        "aliases": [
          "Inform 6"
        ],
        "extensions": [
          ".inf"
        ]
      }
    ],
    "grammars": [
      {
        "language": "beguile",
        "scopeName": "source.beguile",
        "path": "./syntaxes/beguile.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.i6.beguile": "inform6",
          "meta.embedded.emitter.i6.beguile": "inform6"
        }
      },
      {
        "scopeName": "beguile.injection.inform6",
        "path": "./syntaxes/beguile-in-inform6.tmLanguage.json",
        "injectTo": [
          "source.inform6"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.bgl.inform6": "beguile",
          "meta.embedded.line.bgl.inform6": "beguile"
        }
      }
    ],
    "configuration": [
      {
        "title": "Edit & Debug",
        "id": "Beguilex",
        "properties": {
          "Beguilex.debugConsoleOutput": {
            "type": "boolean",
            "default": false,
            "description": "Mirror game text output to the Debug Console in real-time during debugging."
          },
          "Beguilex.interpreterTheme": {
            "type": "string",
            "enum": [
              "auto",
              "dark",
              "light"
            ],
            "enumDescriptions": [
              "Follow the active VS Code color theme",
              "Dark background",
              "Light / parchment background"
            ],
            "default": "auto",
            "description": "Color theme for the interpreter panels."
          }
        }
      },
      {
        "title": "Beguiler",
        "id": "Beguiler",
        "properties": {
          "beguiler.path": {
            "order": 1,
            "type": "string",
            "default": "",
            "markdownDescription": "Path to the beguiler compiler binary. *(Should be an absolute path.)*"
          },
          "beguiler.libraryPath": {
            "order": 2,
            "type": "string",
            "default": "beguiLib",
            "markdownDescription": "Path to the Beguile system library. *(Can be absolute, or relative to the beguiler binary.)*"
          },
          "beguiler.outputPath": {
            "order": 3,
            "type": "string",
            "default": "output",
            "markdownDescription": "Output directory for compiled game files. *(Should be relative to the source file.)*"
          },
          "beguiler.errorFormat": {
            "order": 5,
            "type": "string",
            "enum": [
              "E0",
              "E1",
              "E2"
            ],
            "enumDescriptions": [
              "Archimedes-style",
              "Microsoft-style",
              "Mac MPW-style"
            ],
            "default": "E1",
            "markdownDescription": "Error output format used by Beguiler. *(Also passed to I6.)*"
          },
          "beguiler.target": {
            "order": 4,
            "type": "string",
            "enum": [
              "",
              "Glulx",
              "Z3",
              "Z5",
              "Z8"
            ],
            "enumDescriptions": [
              "Use the target specified in the .bgl source file",
              "Glulx (32-bit, .ulx)",
              "Z-machine version 3 (.z3)",
              "Z-machine version 5 (.z5)",
              "Z-machine version 8 (.z8)"
            ],
            "default": "",
            "markdownDescription": "Target platform. *(Usually set in source.)*"
          },
          "beguiler.includePaths": {
            "order": 6,
            "type": "string",
            "default": "",
            "markdownDescription": "Additional search paths for #include directives, used by both Beguile and Inform 6. *(Multiple paths may be comma-separated. Usually set in source.)*"
          },
          "beguiler.extraArgs": {
            "order": 7,
            "type": "string",
            "default": "",
            "description": "Extra command-line arguments appended to every beguiler invocation."
          }
        }
      },
      {
        "title": "Inform 6",
        "id": "i6",
        "properties": {
          "i6.inform6Path": {
            "order": 1,
            "type": "string",
            "default": "",
            "markdownDescription": "Path to the Inform 6 compiler binary. *(Should be an absolute path.)*"
          },
          "i6.inform6ExtraArgs": {
            "order": 2,
            "type": "string",
            "default": "",
            "description": "Extra command-line arguments forwarded to the Inform 6 compiler."
          },
          "i6.passDebugFlag": {
            "order": 3,
            "type": "boolean",
            "default": false,
            "markdownDescription": "When enabled, pass `-D` to the Inform 6 compiler during debug builds. This defines the `DEBUG` constant, enabling debug verbs such as `ACTIONS`, `PURLOIN`, `GOTO`, and `TRACE`."
          }
        }
      },
      {
        "title": "Language Server",
        "id": "beguile",
        "properties": {
          "beguile.trace.server": {
            "type": "string",
            "enum": ["off", "messages", "compact", "verbose"],
            "default": "off",
            "description": "Traces the communication between VS Code and the Beguile language server."
          }
        }
      }
    ],
    "views": {
      "debug": [
        {
          "type": "webview",
          "id": "beguile.variableFilter",
          "name": "Variable Filter",
          "when": "debugType == beguile"
        }
      ]
    },
    "breakpoints": [
      {
        "language": "beguile"
      },
      {
        "language": "inform6"
      },
      {
        "language": "c"
      }
    ],
    "debuggers": [
      {
        "type": "beguile",
        "label": "Beguile",
        "languages": [
          "beguile"
        ]
      }
    ],
    "commands": [
      {
        "command": "beguile.play",
        "title": "Beguile: Play"
      },
      {
        "command": "beguile.debug",
        "title": "Beguile: Debug"
      },
      {
        "command": "beguile.openI6Source",
        "title": "Open I6 Source at Current Line",
        "icon": {
          "light": "./media/i6-light.svg",
          "dark": "./media/i6-dark.svg"
        }
      },
      {
        "command": "beguile.openBglSource",
        "title": "Open BGL Source at Current Line",
        "icon": {
          "light": "./media/bgl-light.svg",
          "dark": "./media/bgl-dark.svg"
        }
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "beguile.openI6Source",
          "when": "beguile.showOpenI6Button && resourceExtname == .bgl",
          "group": "navigation"
        },
        {
          "command": "beguile.openBglSource",
          "when": "beguile.showOpenBglButton && resourceExtname == .inf",
          "group": "navigation"
        }
      ]
    },
    "configurationDefaults": {
      "[beguile]": {
        "editor.semanticHighlighting.enabled": true
      }
    },
    "semanticTokenScopes": [
      {
        "scopes": {
          "type": [
            "entity.name.type"
          ],
          "class": [
            "entity.name.type.class"
          ],
          "class.declaration": [
            "entity.name.type.class"
          ],
          "enum": [
            "entity.name.type.enum"
          ],
          "enum.declaration": [
            "entity.name.type.enum"
          ],
          "enumMember": [
            "variable.other.enummember"
          ],
          "variable": [
            "variable.other.readwrite"
          ],
          "property": [
            "support.type.property-name",
            "variable.other.property"
          ],
          "property.declaration": [
            "support.type.property-name",
            "variable.other.property"
          ],
          "method": [
            "entity.name.function.member"
          ],
          "method.declaration": [
            "entity.name.function.member"
          ],
          "function": [
            "entity.name.function"
          ],
          "function.declaration": [
            "entity.name.function"
          ]
        }
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test:debug": "tsc -p ./ && node ./out/test/debugMapHarness.js",
    "test:debug:runtime": "tsc -p ./ && node ./out/test/runtime/runtimeHarness.js",
    "package": "vsce package",
    "deploy": "tsc -p ./ && code --command workbench.action.reloadWindow"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.75.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "ifvms": "^1.1.6",
    "quixe": "^0.3.3",
    "vscode-languageclient": "^9.0.1"
  }
}
