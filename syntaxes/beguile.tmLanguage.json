{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Beguile",
  "scopeName": "source.beguile",
  "fileTypes": ["bgl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#i6-block" },
    { "include": "#i6-line" },
    { "include": "#emitter-body-single" },
    { "include": "#emitter-body-multi" },
    { "include": "#interpolated-strings" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#dictionary-words" },
    { "include": "#numeric-literals" },
    { "include": "#emitter-vars" },
    { "include": "#preprocessor" },
    { "include": "#grammar-token-calls" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-type-declaration" },
    { "include": "#keywords-type-primitive" },
    { "include": "#grammar-tokens" },
    { "include": "#constants-language" },
    { "include": "#keyword-self" },
    { "include": "#function-definition" },
    { "include": "#operators" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.block.beguile",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.beguile" }
          }
        },
        {
          "name": "comment.line.double-slash.beguile",
          "match": "//.*$",
          "captures": {
            "0": { "name": "punctuation.definition.comment.beguile" }
          }
        }
      ]
    },

    "i6-block": {
      "comment": "Raw Inform 6 block: #i6 { ... }. Captures leading whitespace in group 1 so the end pattern can require the closing } at the same indentation level, regardless of column position.",
      "name": "meta.embedded.block.i6.beguile",
      "begin": "^(\\s*)#i6\\s*\\{",
      "end": "^\\1\\}",
      "beginCaptures": {
        "0": { "name": "keyword.control.directive.beguile" }
      },
      "endCaptures": {
        "0": { "name": "keyword.control.directive.beguile" }
      },
      "contentName": "meta.embedded.block.i6.beguile",
      "patterns": [
        { "include": "source.inform6" }
      ]
    },

    "i6-line": {
      "comment": "Single-line #i6 directive: #i6 i6code (no braces — parser reads to end of line). Negative lookahead ensures the block form #i6 { is handled by i6-block instead.",
      "match": "(#i6)\\s+(?!\\{)([^\\n]*)",
      "captures": {
        "1": { "name": "keyword.control.directive.beguile" },
        "2": {
          "patterns": [
            { "include": "source.inform6" }
          ]
        }
      }
    },

    "emitter-body-single": {
      "comment": "Single-line emitter body: emitter TYPE NAME(params) { i6expr }. Must match before multi-line rule.",
      "match": "\\bemitter\\b([^{\\n]*)\\{([^\\n}]*)\\}",
      "captures": {
        "1": {
          "patterns": [
            { "include": "#keywords-type-primitive" },
            { "include": "#function-definition" }
          ]
        },
        "2": {
          "patterns": [
            { "include": "#emitter-vars" },
            { "include": "source.inform6" }
          ]
        }
      }
    },

    "emitter-body-multi": {
      "comment": "Multi-line emitter body. Indentation back-reference ensures } matches opener's indent level.",
      "begin": "^(\\s*)\\bemitter\\b[^\\n]*\\{[^\\n}]*$",
      "end": "^\\1\\}",
      "beginCaptures": {
        "0": {
          "patterns": [
            { "include": "#keywords-declaration" },
            { "include": "#keywords-type-primitive" },
            { "include": "#function-definition" }
          ]
        }
      },
      "endCaptures": {
        "0": { "name": "keyword.control.directive.beguile" }
      },
      "contentName": "meta.embedded.emitter.i6.beguile",
      "patterns": [
        { "include": "#emitter-vars" },
        { "include": "source.inform6" }
      ]
    },

    "interpolated-strings": {
      "comment": "Interpolated string literal: $\"text {expr} text\". Outer rule has no name so {expr} spans inherit code colors, not string color.",
      "begin": "(\\$)(\")",
      "end": "\"",
      "beginCaptures": {
        "1": { "name": "keyword.operator.string.interpolated.beguile" },
        "2": { "name": "punctuation.definition.string.begin.beguile" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.beguile" }
      },
      "patterns": [
        {
          "comment": "Interpolated expression span: { ... }. Negative lookbehind prevents \\{ escape from triggering.",
          "name": "meta.interpolation.beguile",
          "begin": "(?<!\\\\)\\{",
          "end": "\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.interpolation.begin.beguile" } },
          "endCaptures": { "0": { "name": "punctuation.section.interpolation.end.beguile" } },
          "patterns": [
            { "include": "$self" }
          ]
        },
        {
          "comment": "Escape sequences. Dual scope includes string.* so VSCode bracket-pair colorizer ignores { here.",
          "name": "string.quoted.double.interpolated.beguile constant.character.escape.beguile",
          "match": "\\\\(?:[\"\\\\n@{]|\\$[0-9a-fA-F]+|\\d+|\\^\\^|~~|[\\^~][aeiouyAEIOUY]|'[aeiouyAEIOUY]|`[aeiouyAEIOUY]|:[aeiouyAEIOUY]|/[oO]|c[cC]|o[aA]|ss|ae|AE|OE|th|et|LL|!!|\\?\\?|<<|>>|[\\^~'`:/])"
        },
        {
          "comment": "Literal string content between interpolation spans",
          "name": "string.quoted.double.interpolated.beguile",
          "match": "[^{\"\\\\]+"
        }
      ]
    },

    "strings": {
      "name": "string.quoted.double.beguile",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.beguile" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.beguile" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.beguile",
          "match": "\\\\(?:[\"\\\\n@]|\\$[0-9a-fA-F]+|\\d+|\\^\\^|~~|[\\^~][aeiouyAEIOUY]|'[aeiouyAEIOUY]|`[aeiouyAEIOUY]|:[aeiouyAEIOUY]|/[oO]|c[cC]|o[aA]|ss|ae|AE|OE|th|et|LL|!!|\\?\\?|<<|>>|[\\^~'`:/])"
        }
      ]
    },

    "char-literals": {
      "name": "string.quoted.single.beguile",
      "match": "'(?:[^'\\\\]|\\\\[\\s\\S])'",
      "captures": {
        "0": { "name": "string.quoted.single.beguile" }
      }
    },

    "dictionary-words": {
      "comment": "Dictionary word literals: ..word (plural) or .word (singular). Negative lookbehind prevents matching member access on identifiers. Scope prefix is string.unquoted so themes color them in the string bucket by default; the .dictionary-word.beguile suffix lets users target dict words specifically in overrides.",
      "patterns": [
        {
          "name": "string.unquoted.dictionary-word.plural.beguile",
          "match": "\\.\\.[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "string.unquoted.dictionary-word.beguile",
          "match": "(?<![a-zA-Z0-9_])\\.([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "0": { "name": "string.unquoted.dictionary-word.beguile" }
          }
        }
      ]
    },

    "numeric-literals": {
      "name": "constant.numeric.integer.beguile",
      "match": "\\b\\d+\\b"
    },

    "emitter-vars": {
      "comment": "Substitution placeholders inside emitter bodies: $self, $prop, $target, $class, $counter, $element, $array, or any $identifier (incl. $<paramname>)",
      "name": "variable.language.self.beguile",
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
    },

    "preprocessor": {
      "patterns": [
        {
          "comment": "#include <system> or #include \"path\"",
          "name": "meta.preprocessor.include.beguile",
          "match": "(#include(?:I6)?)\\s*(?:(<[^>]*>)|(\"[^\"]*\"))",
          "captures": {
            "1": { "name": "keyword.control.directive.include.beguile" },
            "2": { "name": "string.quoted.other.lt-gt.beguile" },
            "3": { "name": "string.quoted.double.beguile" }
          }
        },
        {
          "comment": "#define NAME — value portion is left unscoped so the main grammar colors numbers/strings/identifiers naturally (matches C/C++/C# behavior).",
          "name": "meta.preprocessor.define.beguile",
          "match": "(#define)\\s+([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "keyword.control.directive.define.beguile" },
            "2": { "name": "entity.name.constant.beguile" }
          }
        },
        {
          "comment": "#if / #elif / #else / #endif conditional compilation — condition expression is left unscoped so the main grammar colors identifiers naturally (matches C/C++/C# behavior).",
          "name": "meta.preprocessor.conditional.beguile",
          "match": "(#(?:if|elif|else|endif))\\b",
          "captures": {
            "1": { "name": "keyword.control.directive.conditional.beguile" }
          }
        },
        {
          "comment": "#once file guard",
          "name": "keyword.control.directive.beguile",
          "match": "#once\\b"
        },
        {
          "comment": "#message, #warning, #error, #exit, #using directives",
          "name": "keyword.control.directive.beguile",
          "match": "#(?:message|warning|error|exit|using)\\b"
        },
        {
          "comment": "#beguilerSettings block header or property reference (#beguilerSettings.propName)",
          "name": "keyword.control.directive.beguile",
          "match": "#beguilerSettings\\b(?:\\.[a-zA-Z_][a-zA-Z0-9_]*)?"
        },
        {
          "comment": "#startup, #emitfirst, #emitlast directives",
          "name": "keyword.control.directive.beguile",
          "match": "#(?:startup|emitfirst|emitlast)\\b"
        }
      ]
    },

    "grammar-token-calls": {
      "comment": "Parameterized grammar tokens: NOUN(Routine) and SCOPE(Routine)",
      "match": "\\b(NOUN|SCOPE)\\s*(\\()([a-zA-Z_][a-zA-Z0-9_]*)(\\))",
      "captures": {
        "1": { "name": "support.constant.grammar-token.beguile" },
        "2": { "name": "punctuation.beguile" },
        "3": { "name": "entity.name.function.beguile" },
        "4": { "name": "punctuation.beguile" }
      }
    },

    "grammar-tokens": {
      "comment": "Built-in grammar pattern tokens (bare, non-parameterized)",
      "name": "support.constant.grammar-token.beguile",
      "match": "\\b(ANYNUMBER|HELD|TOPIC|MULTI|MULTIHELD|MULTIEXCEPT|MULTIINSIDE|MULTIFIRST)\\b"
    },

    "keywords-control": {
      "name": "keyword.control.beguile",
      "match": "\\b(if|else|for|while|do|switch|case|break|continue|return|rtrue|rfalse|in|to|try|catch|throw|new|delete)\\b"
    },

    "keywords-declaration": {
      "name": "storage.modifier.beguile",
      "match": "\\b(extern|extend|emitter|replace|const|alias|readonly|static|explicit|default)\\b"
    },

    "keywords-type-declaration": {
      "name": "storage.type.beguile",
      "match": "\\b(class|object|enum|bnum|verb|grammar|attribute|grammarElement|grammarPattern|grammarRule|grammarRuleList)\\b"
    },

    "keywords-type-primitive": {
      "name": "storage.type.primitive.beguile",
      "match": "\\b(int|uint|bool|string|char|void|var|array|func|eBool|dictionaryWord)\\b"
    },

    "constants-language": {
      "name": "constant.language.beguile",
      "match": "\\b(true|false|null|selfobj|nothing|thedark|replaced)\\b"
    },

    "keyword-self": {
      "name": "variable.language.self.beguile",
      "match": "\\bself\\b"
    },

    "function-definition": {
      "comment": "Highlight function/method name in definitions: returnType functionName(",
      "match": "(?<![.])\\b([a-zA-Z_][a-zA-Z0-9_<>]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "2": { "name": "entity.name.function.beguile" }
      }
    },

    "operators": {
      "patterns": [
        {
          "comment": "operator keyword in operator declarations (operator ?, operator switch, etc.)",
          "match": "\\b(operator)\\s+([?]|switch|==|!=|=~|<|>|<=|>=|\\+|-|\\*|/|%)",
          "captures": {
            "1": { "name": "storage.modifier.beguile" },
            "2": { "name": "entity.name.function.beguile" }
          }
        },
        {
          "name": "keyword.operator.beguile",
          "match": "\\?\\.|\\.\\.|==|!=|=~|<<=|>>=|<=|>=|=>|&&|\\|\\||\\+\\+|--|\\+=|-=|\\*=|/=|%=|\\|=|&=|\\^=|<<|>>|\\?\\?"
        },
        {
          "name": "keyword.operator.beguile",
          "match": "[+\\-*/%<>&|^!~=?]"
        }
      ]
    }

  }
}
