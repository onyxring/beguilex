{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Beguile",
  "scopeName": "source.beguile",
  "fileTypes": ["bgl"],
  "patterns": [
    { "include": "#comments" },
    { "include": "#i6-block" },
    { "include": "#strings" },
    { "include": "#char-literals" },
    { "include": "#dictionary-words" },
    { "include": "#numeric-literals" },
    { "include": "#emitter-vars" },
    { "include": "#preprocessor" },
    { "include": "#grammar-token-calls" },
    { "include": "#keywords-control" },
    { "include": "#keywords-declaration" },
    { "include": "#keywords-type-declaration" },
    { "include": "#keywords-type-primitive" },
    { "include": "#grammar-tokens" },
    { "include": "#constants-language" },
    { "include": "#keyword-self" },
    { "include": "#function-definition" },
    { "include": "#operators" }
  ],
  "repository": {

    "comments": {
      "patterns": [
        {
          "name": "comment.block.beguile",
          "begin": "/\\*",
          "end": "\\*/",
          "captures": {
            "0": { "name": "punctuation.definition.comment.beguile" }
          }
        },
        {
          "name": "comment.line.double-slash.beguile",
          "match": "//.*$",
          "captures": {
            "0": { "name": "punctuation.definition.comment.beguile" }
          }
        }
      ]
    },

    "i6-block": {
      "comment": "Raw Inform 6 block: #i6 { ... } or #i6raw { ... }. Captures leading whitespace in group 1 so the end pattern can require the closing } at the same indentation level, regardless of column position.",
      "name": "meta.embedded.block.i6.beguile",
      "begin": "^(\\s*)#i6(?:raw)?\\s*\\{",
      "end": "^\\1\\}",
      "beginCaptures": {
        "0": { "name": "keyword.control.directive.beguile" }
      },
      "endCaptures": {
        "0": { "name": "keyword.control.directive.beguile" }
      },
      "contentName": "meta.embedded.block.i6.beguile",
      "patterns": [
        { "include": "source.inform6" }
      ]
    },

    "strings": {
      "name": "string.quoted.double.beguile",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": { "name": "punctuation.definition.string.begin.beguile" }
      },
      "endCaptures": {
        "0": { "name": "punctuation.definition.string.end.beguile" }
      },
      "patterns": [
        {
          "name": "constant.character.escape.beguile",
          "match": "\\\\[\"\\\\n]"
        }
      ]
    },

    "char-literals": {
      "name": "string.quoted.single.beguile",
      "match": "'(?:[^'\\\\]|\\\\[\\s\\S])'",
      "captures": {
        "0": { "name": "string.quoted.single.beguile" }
      }
    },

    "dictionary-words": {
      "comment": "Dictionary word literals: ..word (plural) or .word (singular). Negative lookbehind prevents matching member access on identifiers.",
      "patterns": [
        {
          "name": "constant.other.dictionary-word.plural.beguile",
          "match": "\\.\\.[a-zA-Z_][a-zA-Z0-9_]*"
        },
        {
          "name": "constant.other.dictionary-word.beguile",
          "match": "(?<![a-zA-Z0-9_])\\.([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "0": { "name": "constant.other.dictionary-word.beguile" }
          }
        }
      ]
    },

    "numeric-literals": {
      "name": "constant.numeric.integer.beguile",
      "match": "\\b\\d+\\b"
    },

    "emitter-vars": {
      "comment": "Substitution placeholders inside emitter bodies: $self, $prop, $counter, $element, $array, or any $identifier",
      "name": "variable.language.self.beguile",
      "match": "\\$[a-zA-Z_][a-zA-Z0-9_]*"
    },

    "preprocessor": {
      "patterns": [
        {
          "comment": "#include <system> or #include \"path\"",
          "name": "meta.preprocessor.include.beguile",
          "match": "(#include(?:I6)?)\\s*(?:(<[^>]*>)|(\"[^\"]*\"))",
          "captures": {
            "1": { "name": "keyword.control.directive.include.beguile" },
            "2": { "name": "string.quoted.other.lt-gt.beguile" },
            "3": { "name": "string.quoted.double.beguile" }
          }
        },
        {
          "comment": "#define NAME value",
          "name": "meta.preprocessor.define.beguile",
          "match": "(#define)\\s+([a-zA-Z_][a-zA-Z0-9_]*)(?:\\s+(.*))?$",
          "captures": {
            "1": { "name": "keyword.control.directive.define.beguile" },
            "2": { "name": "entity.name.constant.beguile" },
            "3": { "name": "constant.other.beguile" }
          }
        },
        {
          "comment": "#if / #elif / #else / #endif conditional compilation",
          "name": "meta.preprocessor.conditional.beguile",
          "match": "#(?:if|elif|else|endif)\\b.*$",
          "captures": {
            "0": { "name": "keyword.control.directive.conditional.beguile" }
          }
        },
        {
          "comment": "#once file guard",
          "name": "keyword.control.directive.beguile",
          "match": "#once\\b"
        },
        {
          "comment": "#beguilerSettings block header",
          "name": "keyword.control.directive.beguile",
          "match": "#beguilerSettings\\b"
        }
      ]
    },

    "grammar-token-calls": {
      "comment": "Parameterized grammar tokens: NOUN(Routine) and SCOPE(Routine)",
      "match": "\\b(NOUN|SCOPE)\\s*(\\()([a-zA-Z_][a-zA-Z0-9_]*)(\\))",
      "captures": {
        "1": { "name": "support.constant.grammar-token.beguile" },
        "2": { "name": "punctuation.beguile" },
        "3": { "name": "entity.name.function.beguile" },
        "4": { "name": "punctuation.beguile" }
      }
    },

    "grammar-tokens": {
      "comment": "Built-in grammar pattern tokens (bare, non-parameterized)",
      "name": "support.constant.grammar-token.beguile",
      "match": "\\b(ANYNUMBER|HELD|TOPIC|MULTI|MULTIHELD|MULTIEXCEPT|MULTIINSIDE|MULTIFIRST)\\b"
    },

    "keywords-control": {
      "name": "keyword.control.beguile",
      "match": "\\b(if|else|for|while|do|switch|case|default|break|continue|return|in)\\b"
    },

    "keywords-declaration": {
      "name": "storage.modifier.beguile",
      "match": "\\b(extern|extend|emitter|replace|const|alias)\\b"
    },

    "keywords-type-declaration": {
      "name": "storage.type.beguile",
      "match": "\\b(class|object|enum|bnum|verb|grammar|attribute)\\b"
    },

    "keywords-type-primitive": {
      "name": "storage.type.primitive.beguile",
      "match": "\\b(int|bool|string|char|void|var|array|func|eBool|dictionaryWord)\\b"
    },

    "constants-language": {
      "name": "constant.language.beguile",
      "match": "\\b(true|false|null)\\b"
    },

    "keyword-self": {
      "name": "variable.language.self.beguile",
      "match": "\\bself\\b"
    },

    "function-definition": {
      "comment": "Highlight function/method name in definitions: returnType functionName(",
      "match": "(?<![.])\\b([a-zA-Z_][a-zA-Z0-9_<>]*)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "captures": {
        "2": { "name": "entity.name.function.beguile" }
      }
    },

    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.beguile",
          "match": "==|!=|<=|>=|=>|&&|\\|\\||\\+\\+|--|\\+=|-=|\\*=|/=|%=|\\|=|&=|\\^=|<<|>>"
        },
        {
          "name": "keyword.operator.beguile",
          "match": "[+\\-*/%<>&|^!~=?]"
        }
      ]
    }

  }
}
